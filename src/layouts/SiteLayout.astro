---
import FileTree from '../components/FileTree.astro';
import IconSprite from '../components/IconSprite.astro';
import Outline from '../components/Outline.astro';
import { loadLibrary, type OutlineItem } from '../lib/docs';
import { site, toContentPath, withBase } from '../lib/site';
import '../styles/global.css';

interface Tab {
	label: string;
	href: string;
	icon?: 'md' | 'folder' | 'files' | 'search' | 'tag';
}

interface Props {
	title: string;
	description?: string;
	author?: string;
	tab?: Tab;
	outline?: OutlineItem[];
}

const { title, description = site.description, author, tab, outline = [] } = Astro.props;
const { tree } = await loadLibrary();
const current = toContentPath(Astro.url.pathname);
const isSearch = current === '/search/';
const isTags = current === '/tags/';
const documentTitle = title === site.nameZh ? `${title} · ${site.name}` : `${title} · ${site.nameZh}`;
const tabIcon = tab?.icon ?? 'md';
---

<!doctype html>
<html lang="zh-CN" data-mode="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			try {
				const params = new URLSearchParams(location.search);
				if (
					params.get('l') === '1' ||
					params.get('m') === 'light' ||
					localStorage.getItem('komeiji-theme') === 'light'
				) {
					document.documentElement.dataset.mode = 'light';
				}
			} catch {}
		</script>
		<meta name="description" content={description} />
		{author && <meta name="author" content={author} />}
		<title>{documentTitle}</title>
		<link rel="icon" href={withBase('/favicon.ico')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&family=Noto+Sans+SC:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<IconSprite />

		<div class="app">
			<nav class="activity" aria-label="快捷入口">
				<div class="act-icons">
					<button
						class:list={['act-btn', { on: !isSearch && !isTags }]}
						type="button"
						data-sidebar-toggle
						title="藏书"
						aria-label="藏书"
						aria-controls="sidebar"
						aria-expanded="true"
					>
						<svg><use href="#i-files"></use></svg>
					</button>
					<a
						class:list={['act-btn', { on: isSearch }]}
						href={withBase('/search/')}
						title="搜索"
						aria-label="搜索"
						aria-current={isSearch ? 'page' : undefined}
						><svg><use href="#i-search"></use></svg></a
					>
					<a
						class="act-btn"
						href="https://github.com/draaaft/Komeiji-Bibliotheca"
						target="_blank"
						rel="noopener noreferrer"
						title="GitHub 仓库"
						aria-label="GitHub 仓库"
						><svg><use href="#i-github"></use></svg></a
					>
					<a
						class:list={['act-btn', { on: isTags }]}
						href={withBase('/tags/')}
						title="标签"
						aria-label="标签"
						aria-current={isTags ? 'page' : undefined}
						><svg><use href="#i-tag"></use></svg></a
					>
				</div>
				<button
					class="act-btn"
					type="button"
					data-theme-toggle
					title="切换深浅色主题"
					aria-label="切换深浅色主题"
				>
					<svg><use href="#i-gear"></use></svg>
				</button>
			</nav>

			<aside class="sidebar" id="sidebar" aria-label="藏书目录">
				<div class="sb-head">藏书</div>
				<div class="ws" title={site.name}>
					<button
						class="chev"
						type="button"
						aria-expanded="true"
						aria-label="折叠文件树"
						title="折叠文件树"
						data-file-tree-toggle
					>
						<svg><use href="#i-chev"></use></svg>
					</button>
					<a href={withBase('/')}>{site.root}</a>
				</div>
				<FileTree nodes={tree} current={current} />
			</aside>

			<main class="main">
				<div class="mobilebar">
					<button
						class="burger"
						type="button"
						aria-label="打开文件树"
						aria-controls="sidebar"
						aria-expanded="false"
					>
						<svg><use href="#i-burger"></use></svg>
					</button>
					<a class="mb-title mono" href={withBase('/')}>~/{site.root}</a>
				</div>

				<div class="tabbar">
					<a
						class:list={['tab', { on: current === '/' }]}
						href={withBase('/')}
						aria-current={current === '/' ? 'page' : undefined}
						data-home
					>
						<svg class="ic"><use href="#i-flag"></use></svg><span>开始</span>
						<span
							class="x"
							role="button"
							tabindex="0"
							data-tab-close
							title="关闭"
							aria-label="关闭 开始">×</span
						>
					</a>
					{
						tab && (
							<a class="tab on" href={tab.href} aria-current="page">
								<svg class="ic"><use href={`#i-${tabIcon}`}></use></svg>
								<span>{tab.label}</span>
								<span
									class="x"
									role="button"
									tabindex="0"
									data-tab-close
									title="关闭"
									aria-label={`关闭 ${tab.label}`}
								>
									×
								</span>
							</a>
						)
					}
					<a class="tab-plus" href={withBase('/')} title="新建标签" aria-label="新建标签">+</a>
				</div>

				<div class="editor" id="editor">
					<div class="page">
						<div class="page-content">
							<slot />
						</div>
						{outline.length > 0 && <Outline headings={outline} />}
					</div>
				</div>
			</main>
		</div>

		<div class="scrim"></div>

		<script>
			(function () {
				const root = document.documentElement;
				const themeToggle = document.querySelector('[data-theme-toggle]');
				themeToggle?.addEventListener('click', () => {
					const mode = root.dataset.mode === 'light' ? 'dark' : 'light';
					root.dataset.mode = mode;
					try {
						localStorage.setItem('komeiji-theme', mode);
					} catch {}
				});

				const body = document.body;
				const sidebarToggle = document.querySelector('[data-sidebar-toggle]');
				const desktop = window.matchMedia('(min-width: 961px)');
				sidebarToggle?.addEventListener('click', () => {
					if (!desktop.matches) return;
					const closed = body.classList.toggle('sidebar-closed');
					sidebarToggle.setAttribute('aria-expanded', String(!closed));
				});

				const burger = document.querySelector('.burger');
				const scrim = document.querySelector('.scrim');
				const setDrawer = (open) => {
					body.classList.toggle('drawer-open', open);
					burger?.setAttribute('aria-expanded', String(open));
				};
				burger?.addEventListener('click', () => setDrawer(!body.classList.contains('drawer-open')));
				scrim?.addEventListener('click', () => setDrawer(false));
				window.addEventListener('pageshow', () => setDrawer(false));

				document.querySelectorAll('[data-tree-toggle]').forEach((button) => {
					button.addEventListener('click', () => {
						const group = button.closest('.tree-node')?.querySelector(':scope > .tree-children');
						if (!group) return;
						const collapsed = !group.hasAttribute('hidden');
						group.toggleAttribute('hidden', collapsed);
						button.setAttribute('aria-expanded', String(!collapsed));
						button.setAttribute(
							'aria-label',
							`${collapsed ? '展开' : '折叠'} ${button.dataset.name ?? ''}`
						);
					});
				});

				const treeRootToggle = document.querySelector('[data-file-tree-toggle]');
				const treeRoot = document.querySelector('#sidebar > .tree');
				treeRootToggle?.addEventListener('click', (event) => {
					event.preventDefault();
					event.stopPropagation();
					if (!treeRoot) return;
					const collapsed = !treeRoot.hasAttribute('hidden');
					treeRoot.toggleAttribute('hidden', collapsed);
					treeRootToggle.setAttribute('aria-expanded', String(!collapsed));
					treeRootToggle.setAttribute('aria-label', `${collapsed ? '展开' : '折叠'}文件树`);
					treeRootToggle.title = `${collapsed ? '展开' : '折叠'}文件树`;
				});

				const homeTab = document.querySelector('[data-home]');
				const startHref = homeTab?.getAttribute('href') ?? '/';
				const atHome = homeTab?.classList.contains('on') ?? false;
				const goHome = () => {
					if (!atHome) location.href = startHref;
				};
				document.querySelectorAll('[data-tab-close]').forEach((close) => {
					const closeTab = (event) => {
						event.preventDefault();
						event.stopPropagation();
						const tab = close.closest('.tab');
						if (!tab) return;
						if (!tab.classList.contains('on')) {
							tab.remove();
							return;
						}
						goHome();
					};
					close.addEventListener('click', closeTab);
					close.addEventListener('keydown', (event) => {
						if (event.key === 'Enter' || event.key === ' ') closeTab(event);
					});
				});
				document.querySelector('.tab-plus')?.addEventListener('click', (event) => {
					if (atHome) event.preventDefault();
				});

				const tocToggle = document.getElementById('toc-toggle');
				tocToggle?.addEventListener('click', () => {
					const off = body.classList.toggle('toc-off');
					tocToggle.setAttribute('aria-expanded', String(!off));
					tocToggle.title = off ? '显示目录' : '隐藏目录';
				});

				document
					.querySelector('.trow[aria-current="page"], .trow.sel')
					?.scrollIntoView({ block: 'nearest' });

				const tocLinks = [...document.querySelectorAll('.toc-i[data-target]')];
				const editor = document.getElementById('editor');

				if (tocLinks.length && editor) {
					const headings = tocLinks
						.map((link) => document.getElementById(link.dataset.target ?? ''))
						.filter((heading) => heading !== null);
					const activate = (id) =>
						tocLinks.forEach((link) => link.classList.toggle('on', link.dataset.target === id));
					const observer = new IntersectionObserver(
						(entries) => {
							const visible = entries
								.filter((entry) => entry.isIntersecting)
								.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
							if (visible[0]) activate(visible[0].target.id);
						},
						{ root: editor, rootMargin: '0px 0px -72% 0px', threshold: 0 }
					);
					headings.forEach((heading) => observer.observe(heading));
				}
			})();
		</script>
	</body>
</html>
