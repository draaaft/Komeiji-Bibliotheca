---
import { withBase } from '../lib/site';

export interface Crumb {
	name: string;
	path?: string;
}

interface Props {
	parts: Crumb[];
}

const { parts } = Astro.props;
---

<nav class="crumb mono" aria-label="路径">
	<a href={withBase('/')}>~</a>
	{
		parts.map((part) => (
			<Fragment>
				<span class="sep">/</span>
				{part.path ? (
					<a href={withBase(part.path)}>{part.name}</a>
				) : (
					<span class="cur">{part.name}</span>
				)}
			</Fragment>
		))
	}
</nav>
