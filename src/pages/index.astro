---
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatDate, latestDate, loadLibrary } from '../lib/docs';
import { site } from '../lib/site';

const { docs } = await loadLibrary();
const recent = docs.slice(0, 6);
---

<SiteLayout title={site.nameZh}>
	<div class="welcome">
		<h1 class="w-title">{site.nameZh}</h1>

		<section class="w-recent" aria-labelledby="recent-title">
			<div class="w-head mono" id="recent-title"><span>藏书</span><span class="w-en">LIBRARY</span></div>
			{
				recent.length > 0 ? (
					recent.map((doc) => {
						const date = latestDate(doc);
						return (
							<a class="w-item" href={doc.path}>
								<svg class="ic"><use href="#i-md"></use></svg>
								<span class="w-t">{doc.title}</span>
								<span class="w-d mono">{date ? formatDate(date) : doc.dir || '根目录'}</span>
							</a>
						);
					})
				) : (
					<p class="empty">还没有内容。</p>
				)
			}
			{
				docs.length > recent.length && (
					<a class="w-more mono" href="/library/">查看全部 {docs.length} 篇 →</a>
				)
			}
		</section>
	</div>
</SiteLayout>
