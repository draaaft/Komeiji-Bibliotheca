---
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatDate, latestDate, loadLibrary } from '../lib/docs';
import { site, withBase } from '../lib/site';

const { docs } = await loadLibrary();
const recent = docs.slice(0, 6);
---

<SiteLayout title={site.nameZh}>
	<div class="welcome">
		<h1 class="w-title">{site.nameZh}</h1>

		<div class="prose w-intro">
			<p>Welcome to Komeiji-Bibliotheca awa!<br />欢迎来到古明寺藏书阁 awa！</p>
			<p>古明寺藏书阁是由几个物理系本科生自发组织的讨论班，此站用于存储和分享我们的文章。</p>
		</div>

		<section class="w-recent" aria-labelledby="recent-title">
			<div class="w-head mono" id="recent-title"><span>文章</span><span class="w-en">LIBRARY</span></div>
			{
				recent.length > 0 ? (
					recent.map((doc) => {
						const date = latestDate(doc);
						return (
							<a class="w-item" href={withBase(doc.path)}>
								<svg class="ic"><use href={doc.format === 'pdf' ? '#i-pdf' : '#i-md'}></use></svg>
								<span class="w-t">{doc.title}</span>
								<span class="w-d mono">{date ? formatDate(date) : doc.dir || '根目录'}</span>
							</a>
						);
					})
				) : (
					<p class="empty">还没有内容。</p>
				)
			}
			{
				docs.length > recent.length && (
					<a class="w-more mono" href={withBase('/library/')}>查看全部 {docs.length} 篇 →</a>
				)
			}
		</section>

		<p style="margin-bottom: 60px;"></p>
		<div class="prose w-intro">
			<blockquote>
				<p>探寻物质世界的规律是人类最伟大的冒险。</p>
				<p>—— Feynman</p>
			</blockquote>
		</div>
	</div>
</SiteLayout>
