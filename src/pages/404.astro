---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/site';
---

<SiteLayout title="页面不存在" noindex>
	<div class="welcome">
		<h1 class="w-title">404</h1>
		<p class="page-sub mono">owo</p>
		<p class="page-sub mono">没有找到这个页面，可能链接写错了，或者这篇文章被移走了。</p>
		<p class="w-more">
			<a href={withBase('/')}>回到首页</a> · <a href={withBase('/library/')}>全部藏书</a>
		</p>
	</div>
</SiteLayout>
