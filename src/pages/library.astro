---
import Breadcrumb from '../components/Breadcrumb.astro';
import DocSearch from '../components/DocSearch.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadLibrary } from '../lib/docs';
import { withBase } from '../lib/site';

const { docs } = await loadLibrary();
---

<SiteLayout title="全部藏书" tab={{ label: '藏书阁', href: withBase('/library/'), icon: 'files' }}>
	<Breadcrumb parts={[{ name: 'library' }]} />

	<header class="page-head">
		<h1 class="page-title">全部藏书</h1>
		<p class="page-sub mono">{docs.length} 篇 · 全部 Markdown 文档</p>
	</header>

	<DocSearch docs={docs} />
</SiteLayout>
